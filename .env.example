# Copy to .env and fill values (gitignored).
# In production, these are set in Netlify dashboard -> Site config -> Environment variables.
#
# Astro convention: any var prefixed with PUBLIC_ is exposed to client-side code at build time.
# Don't put server-secrets here — use unprefixed names for those.

# PostHog Web Analytics (cookieless mode)
# Project public key — same as the app's EXPO_PUBLIC_POSTHOG_API_KEY.
# Get from: https://us.posthog.com/settings/project
PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
