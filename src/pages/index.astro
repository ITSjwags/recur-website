---
import FeatureCard from '../components/FeatureCard.astro';
import Footer from '../components/Footer.astro';
import Nav from '../components/Nav.astro';
import SectionLabel from '../components/SectionLabel.astro';
import Base from '../layouts/Base.astro';

const APP_STORE_URL = 'https://apps.apple.com/us/app/recur-fit/id6757411689';
const PLAY_STORE_URL = 'https://play.google.com/store/apps/details?id=fit.recur.app';
---

<Base title="Recur | Built for bodies with history." description="Strength training for adults who train at home and want to stay consistent without getting hurt or burned out. Adapts to breaks, works around pain, builds momentum that lasts.">
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'MobileApplication',
    name: 'Recur',
    description: 'Strength training that adapts to your history. Built for bodies with history.',
    applicationCategory: 'HealthApplication',
    operatingSystem: 'iOS, Android',
    url: 'https://recur.fit',
    downloadUrl: [APP_STORE_URL, PLAY_STORE_URL],
    offers: [
      {
        '@type': 'Offer',
        name: 'Free',
        price: '0',
        priceCurrency: 'USD',
      },
      {
        '@type': 'Offer',
        name: 'Pro Monthly',
        price: '9.99',
        priceCurrency: 'USD',
      },
      {
        '@type': 'Offer',
        name: 'Pro Yearly',
        price: '79.99',
        priceCurrency: 'USD',
      },
    ],
  })} />
  <main class="min-h-[100dvh] bg-background text-foreground overflow-x-hidden">
    <Nav />

    <!-- Hero -->
    <section class="relative min-h-[90vh] overflow-hidden bg-background">
      <img
        src="/lifestyle-hero.webp"
        alt="Person doing home workout"
        fetchpriority="high"
        class="absolute inset-0 w-full h-full object-cover object-center opacity-25 mix-blend-multiply dark:opacity-40 dark:mix-blend-luminosity"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-background via-background/85 to-transparent"></div>
      <div class="relative z-10 max-w-6xl mx-auto px-6 flex items-center min-h-[90vh]">
        <div class="w-full md:w-2/3">
          <div class="flex flex-col items-start pt-24 pb-20 md:py-0">
            <h1 class="animate-fade-up stagger-1 text-[clamp(3.2rem,7vw,6.5rem)] font-semibold tracking-tighter leading-[1.0] text-foreground mb-6">
              Built for bodies<br />with history.
            </h1>
            <p class="animate-fade-up stagger-2 text-xl md:text-2xl text-muted-foreground max-w-md mb-10 leading-relaxed">
              Strength training that adapts to yours.
            </p>
            <div class="animate-fade-up stagger-3 flex flex-col sm:flex-row sm:items-center items-start gap-4">
              <a href={APP_STORE_URL} class="inline-block" target="_blank" rel="noopener noreferrer" data-track="app_store_clicked" data-track-location="hero">
                <img
                  src="/app-store-badge.png"
                  alt="Download on the App Store"
                  width="200"
                  height="67"
                  class="block h-[60px] w-auto"
                />
              </a>
              <a href={PLAY_STORE_URL} class="inline-block" target="_blank" rel="noopener noreferrer" data-track="play_store_clicked" data-track-location="hero">
                <img
                  src="/google-play-badge.png"
                  alt="Get it on Google Play"
                  width="201"
                  height="60"
                  class="block h-[60px] w-auto"
                />
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Value prop band -->
    <section class="bg-surface-dark py-20 border-t border-white/5">
      <div class="max-w-6xl mx-auto px-6">
        <p class="animate-on-scroll text-3xl md:text-5xl lg:text-6xl font-semibold leading-tight tracking-tight text-surface-dark-foreground">
          Adapts to breaks.<br />
          Works around pain.<br />
          <span class="text-primary-light">Builds momentum that lasts.</span>
        </p>
      </div>
    </section>

    <!-- Who this is for -->
    <section class="py-28">
      <div class="max-w-6xl mx-auto px-6 grid md:grid-cols-2 gap-16 items-start">
        <div class="animate-on-scroll">
          <SectionLabel class="mb-6">Who it's for</SectionLabel>
          <h2 class="text-3xl md:text-4xl font-semibold leading-snug tracking-tight">
            People who keep<br />coming back.
          </h2>
        </div>
        <p class="animate-on-scroll text-lg md:text-xl text-muted-foreground leading-relaxed">
          You've trained before. You've stopped before. Maybe you've got an
          old injury that flares up, or a schedule that makes consistency
          hard. <strong class="text-foreground font-semibold">Recur is for people who know that perfect weeks don't exist</strong> and want an app that gets it.
        </p>
      </div>
    </section>

    <!-- Features -->
    <section class="py-24 bg-card border-y border-border/60">
      <div class="max-w-6xl mx-auto px-6">
        <SectionLabel class="animate-on-scroll mb-16">A different relationship with training</SectionLabel>
        <div class="grid md:grid-cols-2 gap-x-20 gap-y-14">
          <FeatureCard title="Progress you don't have to reset" stagger={1}>
            <svg slot="icon" class="w-6 h-6" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
            It learns from your actual sessions: how hard you pushed, what you swapped, how your body responded. Then it builds from there. Take a couple weeks off? We automatically ease you back in. No punishment, no starting over.
          </FeatureCard>
          <FeatureCard title="Works around pain, not through it" stagger={2}>
            <svg slot="icon" class="w-6 h-6" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path><polyline points="9 12 12 15 16 10"></polyline></svg>
            Flag an ache, we route around it. Shoulders, knees, back. The app learns what bothers you and keeps you moving without aggravating it.
          </FeatureCard>
          <FeatureCard title="Just tap start" stagger={1}>
            <svg slot="icon" class="w-6 h-6" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
            No planning, no decision fatigue. We generate your workout based on what you need today, so the hardest part is just showing up.
          </FeatureCard>
          <FeatureCard title="Built for home workouts" stagger={2}>
            <svg slot="icon" class="w-6 h-6" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
            Dumbbells. Kettlebells. Bodyweight. Whatever you've got works. No gym, no complicated setup. Just strength training that adapts to what you already have.
          </FeatureCard>
        </div>
      </div>
    </section>

    <!-- Pricing -->
    <section id="pricing" class="py-28">
      <div class="max-w-6xl mx-auto px-6">
        <div class="animate-on-scroll mb-16 max-w-3xl">
          <SectionLabel class="mb-6">Pricing</SectionLabel>
          <h2 class="text-3xl md:text-5xl font-semibold leading-tight tracking-tight mb-6">
            Every workout. Free.
          </h2>
          <p class="text-lg md:text-xl text-muted-foreground leading-relaxed">
            Three a week, no card. Pay for unlimited, full history, and progress charts.
          </p>
        </div>

        <div class="grid md:grid-cols-2 gap-6">
          <!-- Free -->
          <div class="animate-on-scroll border border-border rounded-3xl p-8 md:p-10 flex flex-col">
            <h3 class="text-2xl font-semibold tracking-tight mb-2">Free</h3>
            <p class="text-muted-foreground mb-8">For three workouts a week.</p>
            <ul class="space-y-3 text-base flex-1">
              <li class="flex gap-3 items-start">
                <svg class="w-5 h-5 text-primary mt-0.5 shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                <span>3 workouts a week</span>
              </li>
              <li class="flex gap-3 items-start">
                <svg class="w-5 h-5 text-primary mt-0.5 shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                <span>Limited workout history</span>
              </li>
              <li class="flex gap-3 items-start">
                <svg class="w-5 h-5 text-primary mt-0.5 shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                <span>No ads, ever</span>
              </li>
            </ul>
            <p class="mt-8 pt-6 border-t border-border text-base font-semibold">Free, forever. No card.</p>
          </div>

          <!-- Pro -->
          <div class="animate-on-scroll border-2 border-primary rounded-3xl p-8 md:p-10 bg-primary/5 flex flex-col" style="animation-delay: 0.1s;">
            <h3 class="text-2xl font-semibold tracking-tight mb-2">Pro</h3>
            <p class="text-muted-foreground mb-8">Everything in Free, plus the data.</p>
            <ul class="space-y-3 text-base flex-1">
              <li class="flex gap-3 items-start">
                <svg class="w-5 h-5 text-primary mt-0.5 shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                <span>Unlimited workouts</span>
              </li>
              <li class="flex gap-3 items-start">
                <svg class="w-5 h-5 text-primary mt-0.5 shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                <span>Full workout history</span>
              </li>
              <li class="flex gap-3 items-start">
                <svg class="w-5 h-5 text-primary mt-0.5 shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                <span>Progress charts for every exercise</span>
              </li>
              <li class="flex gap-3 items-start">
                <svg class="w-5 h-5 text-primary mt-0.5 shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                <span>Priority support</span>
              </li>
            </ul>
            <p class="mt-8 pt-6 border-t border-primary/30 text-base font-semibold">
              <span class="text-foreground">$9.99</span><span class="text-muted-foreground"> / month</span>
              <span class="text-muted-foreground"> &middot; </span>
              <span class="text-foreground">$79.99</span><span class="text-muted-foreground"> / year</span>
              <span class="text-primary"> (best value)</span>
            </p>
          </div>
        </div>

      </div>
    </section>

    <!-- Lifestyle image block -->
    <section class="py-10 pb-24">
      <div class="max-w-6xl mx-auto px-6">
        <div class="animate-on-scroll rounded-3xl overflow-hidden relative bg-foreground dark:bg-card">
          <img
            src="/lifestyle.webp"
            alt="Person working out calmly at home with dumbbells"
            loading="lazy"
            class="w-full h-[420px] md:h-[560px] object-cover opacity-40 mix-blend-luminosity dark:opacity-40 dark:mix-blend-luminosity"
          />
          <div class="absolute inset-0 flex items-end p-10 md:p-16">
            <div class="max-w-lg">
              <p class="text-3xl md:text-5xl font-semibold text-surface-dark-foreground leading-tight tracking-tight">
                Show up when you can. It's enough.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section id="faq" class="py-28">
      <script type="application/ld+json" is:inline set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: [
          {
            '@type': 'Question',
            name: 'Is Recur free?',
            acceptedAnswer: {
              '@type': 'Answer',
              text: 'Yes. The free tier gives you 3 workouts per week with no credit card required. Pro unlocks unlimited workouts, full history, and progress charts for $9.99/month or $79.99/year.',
            },
          },
          {
            '@type': 'Question',
            name: 'What equipment do I need?',
            acceptedAnswer: {
              '@type': 'Answer',
              text: 'Dumbbells, kettlebells, bodyweight — whatever you already have. Recur adapts to your available equipment. No gym required.',
            },
          },
          {
            '@type': 'Question',
            name: 'What if I haven\'t trained in a while?',
            acceptedAnswer: {
              '@type': 'Answer',
              text: 'Recur detects breaks in your training history and automatically eases you back in. No punishment, no starting over — it picks up where your body actually is.',
            },
          },
          {
            '@type': 'Question',
            name: 'What if I have an injury or pain?',
            acceptedAnswer: {
              '@type': 'Answer',
              text: 'Flag the area that bothers you — shoulders, knees, back, or others — and Recur routes around it. It learns what aggravates you and keeps programming movements that don\'t.',
            },
          },
          {
            '@type': 'Question',
            name: 'Is Recur available on Android?',
            acceptedAnswer: {
              '@type': 'Answer',
              text: 'Yes. Recur is available on both iOS (App Store) and Android (Google Play).',
            },
          },
          {
            '@type': 'Question',
            name: 'Do I need to plan my own workouts?',
            acceptedAnswer: {
              '@type': 'Answer',
              text: 'No. Recur generates your workout based on your history, equipment, and how your body has been responding. Just tap start.',
            },
          },
        ],
      })} />
      <div class="max-w-6xl mx-auto px-6">
        <div class="animate-on-scroll mb-16 max-w-3xl">
          <SectionLabel class="mb-6">FAQ</SectionLabel>
          <h2 class="text-3xl md:text-5xl font-semibold leading-tight tracking-tight">
            Common questions.
          </h2>
        </div>
        <dl class="max-w-3xl space-y-8">
          <div class="animate-on-scroll">
            <dt class="text-lg font-semibold mb-2">Is Recur free?</dt>
            <dd class="text-muted-foreground leading-relaxed">Yes. The free tier gives you 3 workouts per week — no credit card required. Pro unlocks unlimited workouts, full history, and progress charts for $9.99/month or $79.99/year.</dd>
          </div>
          <div class="animate-on-scroll">
            <dt class="text-lg font-semibold mb-2">What equipment do I need?</dt>
            <dd class="text-muted-foreground leading-relaxed">Dumbbells, kettlebells, bodyweight — whatever you already have. Recur adapts to your available equipment. No gym required.</dd>
          </div>
          <div class="animate-on-scroll">
            <dt class="text-lg font-semibold mb-2">What if I haven't trained in a while?</dt>
            <dd class="text-muted-foreground leading-relaxed">Recur detects gaps in your training history and automatically eases you back in. No punishment, no starting over — it picks up where your body actually is.</dd>
          </div>
          <div class="animate-on-scroll">
            <dt class="text-lg font-semibold mb-2">What if I have an injury or pain?</dt>
            <dd class="text-muted-foreground leading-relaxed">Flag the area that bothers you — shoulders, knees, back, or others — and Recur routes around it. It learns what aggravates you and keeps programming movements that don't.</dd>
          </div>
          <div class="animate-on-scroll">
            <dt class="text-lg font-semibold mb-2">Is Recur available on Android?</dt>
            <dd class="text-muted-foreground leading-relaxed">Yes. Recur is available on both iOS (App Store) and Android (Google Play).</dd>
          </div>
          <div class="animate-on-scroll">
            <dt class="text-lg font-semibold mb-2">Do I need to plan my own workouts?</dt>
            <dd class="text-muted-foreground leading-relaxed">No. Recur generates your workout based on your history, equipment, and how your body has been responding. Just tap start.</dd>
          </div>
        </dl>
      </div>
    </section>

    <!-- Download CTA -->
    <section
      id="download"
      class="py-32 bg-surface-dark relative overflow-hidden border-t border-white/5"
    >
      <div class="absolute -top-40 -right-40 w-[500px] h-[500px] rounded-full bg-primary/15 blur-3xl pointer-events-none"></div>
      <div class="absolute -bottom-40 -left-40 w-[400px] h-[400px] rounded-full bg-primary/8 blur-3xl pointer-events-none"></div>

      <div class="max-w-6xl mx-auto px-6 text-center relative z-10">
        <div class="animate-on-scroll">
          <SectionLabel class="text-primary mb-5">Ready when you are.</SectionLabel>
          <h2 class="text-5xl md:text-7xl font-semibold tracking-tight mb-12 text-surface-dark-foreground">
            Stop starting<br />over.
          </h2>
        </div>

        <div class="animate-on-scroll flex flex-col sm:flex-row sm:items-center justify-center items-center gap-4">
          <a href={APP_STORE_URL} class="inline-block" target="_blank" rel="noopener noreferrer" data-track="app_store_clicked" data-track-location="footer_cta">
            <img
              src="/app-store-badge.png"
              alt="Download on the App Store"
              width="200"
              height="67"
              class="block h-[60px] w-auto"
            />
          </a>
          <a href={PLAY_STORE_URL} class="inline-block" target="_blank" rel="noopener noreferrer" data-track="play_store_clicked" data-track-location="footer_cta">
            <img
              src="/google-play-badge.png"
              alt="Get it on Google Play"
              width="207"
              height="80"
              class="block h-[60px] w-auto"
            />
          </a>
        </div>
      </div>
    </section>

    <Footer />
  </main>
</Base>
