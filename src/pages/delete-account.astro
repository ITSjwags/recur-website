---
import ContentPage from '../layouts/ContentPage.astro';
---

<ContentPage title="Delete your account | Recur">
  <h1 class="text-4xl font-semibold tracking-tight mb-2">Delete your account</h1>
  <p class="text-sm text-muted-foreground mb-12">Last updated: April 2026</p>

  <div class="max-w-none space-y-10 text-foreground">
    <p class="text-lg text-muted-foreground leading-relaxed">
      Recur is a workout app made by Recur. You can request permanent deletion of your account and all associated data at any time.
    </p>

    <section>
      <h2 class="text-2xl font-semibold mb-4">How to request deletion</h2>
      <p class="text-muted-foreground leading-relaxed">
        Email <a href="mailto:hello@recur.fit">hello@recur.fit</a> from the email address on your Recur account with the subject line <em>Delete my account</em>. We will delete your account within 30 days and reply to confirm.
      </p>
    </section>

    <section>
      <h2 class="text-2xl font-semibold mb-4">What gets deleted</h2>
      <ul>
        <li>Your account (email and authentication records)</li>
        <li>All workout logs, sets, reps, and history</li>
        <li>Pain flags, equipment selections, and preferences</li>
        <li>Subscription records linked to your account</li>
      </ul>
    </section>

    <section>
      <h2 class="text-2xl font-semibold mb-4">What we keep</h2>
      <ul>
        <li>Anonymized aggregate analytics with no user identifier</li>
        <li>Financial transaction records required by tax and accounting law (typically retained for 7 years)</li>
      </ul>
    </section>

    <section>
      <h2 class="text-2xl font-semibold mb-4">Questions?</h2>
      <p class="text-muted-foreground leading-relaxed">
        Email <a href="mailto:hello@recur.fit">hello@recur.fit</a>.
      </p>
    </section>
  </div>
</ContentPage>
