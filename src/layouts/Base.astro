---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const SITE_URL = 'https://recur.fit';

const {
  title,
  description = 'Strength training for adults who train at home and want to stay consistent without getting hurt or burned out.',
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, SITE_URL).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${SITE_URL}/opengraph.png`} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Recur" />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${SITE_URL}/opengraph.png`} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/icon.png" />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'Organization',
          name: 'Recur',
          url: SITE_URL,
          logo: `${SITE_URL}/icon.png`,
          description: 'Strength training for adults who train at home.',
        },
        {
          '@type': 'WebSite',
          name: 'Recur',
          url: SITE_URL,
        },
      ],
    })} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <title>{title}</title>
    <!-- Theme: prevent flash of wrong color scheme -->
    <script is:inline>
      (function() {
        const stored = localStorage.getItem('recur-theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (stored === 'dark' || (!stored && prefersDark)) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
  </head>
  <body>
    <slot />
    <!-- Scroll animation observer -->
    <script is:inline>
      (function() {
        var els = document.querySelectorAll('.animate-on-scroll');
        if (!els.length) return;
        var observer = new IntersectionObserver(function(entries) {
          entries.forEach(function(entry) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.15, rootMargin: '-40px' });
        els.forEach(function(el) { observer.observe(el); });
      })();
    </script>
  </body>
</html>
