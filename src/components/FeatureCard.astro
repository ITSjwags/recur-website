---
interface Props {
  title: string;
  stagger?: 1 | 2;
}

const { title, stagger = 1 } = Astro.props;
---

<div class={`animate-on-scroll stagger-${stagger} flex gap-6`}>
  <div class="flex-shrink-0 w-12 h-12 rounded-2xl bg-primary/10 flex items-center justify-center text-primary mt-0.5">
    <slot name="icon" />
  </div>
  <div>
    <h3 class="text-xl font-semibold mb-3">{title}</h3>
    <p class="text-muted-foreground leading-relaxed"><slot /></p>
  </div>
</div>
