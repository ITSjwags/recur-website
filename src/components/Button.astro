---
interface Props {
  href?: string;
  type?: 'button' | 'submit';
  class?: string;
}

const { href, type, class: className = '' } = Astro.props;
const base =
  'inline-flex items-center gap-2 px-6 py-3.5 rounded-full bg-primary text-primary-foreground text-sm font-semibold whitespace-nowrap transition-all hover:bg-primary/85 active:scale-95 disabled:opacity-60';
const classes = `${base} ${className}`.trim();
---

{href ? (
  <a href={href} class={classes}><slot /></a>
) : (
  <button type={type || 'button'} class={classes}><slot /></button>
)}
