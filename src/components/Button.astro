---
interface Props {
  href?: string;
  type?: 'button' | 'submit';
  size?: 'sm' | 'default';
  class?: string;
}

const { href, type, size = 'default', class: className = '' } = Astro.props;
const sizeClasses = size === 'sm' ? 'px-5 py-2 text-sm' : 'px-6 py-3.5 text-sm';
const base = `inline-flex items-center gap-2 ${sizeClasses} rounded-full bg-primary text-primary-foreground font-semibold whitespace-nowrap transition-all hover:bg-primary/85 active:scale-95 disabled:opacity-60`;
const classes = `${base} ${className}`.trim();
---

{href ? (
  <a href={href} class={classes}><slot /></a>
) : (
  <button type={type || 'button'} class={classes}><slot /></button>
)}
